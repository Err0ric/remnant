# Copy to .env. Everything here is optional.
# Folder on the host with the log files to read (mounted read-only at /logs).
# LOGS_DIR=./logs
# Name analysts type to reach this server; used in the setup link and the certificate.
# APP_PUBLIC_NAME=siem.corp.example
# Address to publish on. 127.0.0.1 = this machine only; 0.0.0.0 = reachable from the network.
# APP_BIND=0.0.0.0
# APP_PORT=8080
# Group that can read the log files (adm = 4 on Debian/Ubuntu, where rsyslog writes 0640 root:adm).
# LOGS_GID=4
# Folder with Sigma rules to import (for example a clone of SigmaHQ/sigma), mounted read-only at /rules.
# RULES_DIR=./rules
# Address analysts open, only if it differs from https://APP_PUBLIC_NAME:8080 (another port, a proxy).
# APP_PUBLIC_URL=https://siem.corp.example
# Behind a reverse proxy: its addresses (IPs or CIDRs, comma separated), so logins and the
# audit log see each person's address instead of the proxy's. For an HA pair, list the nodes.
# TRUSTED_PROXIES=192.0.2.10,192.0.2.11
#
# Optional single sign-on with Microsoft Entra ID or another OIDC provider. See docs/install/sso-entra.md.
# Keep this file readable by root only (chmod 600 .env) once it holds the secret.
# SSO_ENABLED=true
# SSO_ISSUER=https://login.microsoftonline.com/<directory-tenant-id>/v2.0
# SSO_CLIENT_ID=<application-client-id>
# SSO_CLIENT_SECRET=<client-secret-value>
# SSO_REQUIRED_GROUPS=<group-object-id>
# SSO_LABEL=Microsoft
# SSO_PASSWORD_LOGIN=admins
# Authelia, Keycloak, Authentik: request groups and read them from UserInfo (docs/install/sso-authelia.md)
# SSO_EXTRA_SCOPES=groups
# SSO_TOKEN_AUTH_METHOD=auto      # or client_secret_basic / client_secret_post
#
# Optional outbound proxy, only if this server cannot reach the internet directly. See docs/install/proxy.md.
# Used by the Microsoft 365 and Anthropic sources and Teams or Slack alerts; everything else stays direct.
# HTTPS_PROXY_URL=http://proxy.corp.example:3128
# PROXY_USERNAME=svc-siem
# PROXY_PASSWORD=<password>
# A proxy that inspects TLS: put its CA certificate (PEM) in ./config and name it here.
# PROXY_CA_BUNDLE=/srv/config/proxy-ca.pem
#
# Ask prompt version (backend/app/llm/prompts). ask.v5 adds follow-up and person-name rules;
# switch after `uv run python -m evals.nl_queries.run ... --prompt ask.v5` scores at least as
# well as ask.v4 on your model (backend/evals/nl_queries/README.md).
# ASK_PROMPT=ask.v5
